# pnpm, and versions that do not move on their own.
#
# `save-exact` is the rule the owner asked for: `pnpm add x` writes `1.2.3`, never `^1.2.3`, so
# upgrading is a commit somebody reviewed rather than something a lockfile refresh decided.
save-exact=true

# The lockfile is committed and CI installs from it; an install that would rewrite it is a mistake,
# not a convenience.
prefer-frozen-lockfile=true

# Ant Design's peer ranges are wider than its behaviour; refusing an install over a peer warning
# helps nobody here, and the type check is the real proof.
strict-peer-dependencies=false

# Vite bundles the result and nothing is published from this directory, so the flat layout npm users
# expect is the least surprising one for bundled CLIs such as oxlint and monaco's worker files.
node-linker=hoisted
