# API-only image: no console build, the server serves the committed
# placeholder page. Use when the operator console is deployed separately.
#   docker build -f Dockerfile.api -t noxis-api .
FROM golang:1.26-alpine AS build
WORKDIR /src/apps/api
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
RUN CGO_ENABLED=0 go build -o /out/noxis ./cmd/noxis

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/noxis /usr/local/bin/noxis
ENTRYPOINT ["noxis"]
