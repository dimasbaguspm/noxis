# First-instance configuration for deploy/docker-compose.yml.
# Copy to `.env` (git-ignored) and fill the three required values:
#
#   cp deploy/.env.example deploy/.env
#
# Only NOXIS_SECRET_KEY is a secret, and it is required.

# Required ---------------------------------------------------------------

# 32 bytes as 64 hex characters. Generate with: openssl rand -hex 32
# Encrypts stored connection passwords. Losing it loses those passwords.
NOXIS_SECRET_KEY=

# The root admin, created on first boot. Log in with these, then change the
# password from Profile. They are ignored once the account exists.
NOXIS_ADMIN_USERNAME=admin
NOXIS_ADMIN_PASSWORD=

# Optional ---------------------------------------------------------------

# Host port the console is published on.
# NOXIS_PORT=9000

# OIDC login, added later alongside the local root admin. When the issuer is
# set, tokens from it are accepted too; the admin group is implicit super admin.
# NOXIS_OIDC_ISSUER=
# NOXIS_OIDC_CLIENT_ID=
# NOXIS_OIDC_ADMIN_GROUP=

# External scheduler: an outside service signs the trigger with this pair.
# NOXIS_SCHEDULER_API_KEY=
# NOXIS_SCHEDULER_SECRET=
