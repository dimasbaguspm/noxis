# Copy to .env and adjust. No variable is prefixed: keep this file the single list of them.

# The API listens on :9000 and keeps /data/noxis.db. Both are constants: a state file that can be
# moved by an environment variable is a journal that can be lost by a typo. The binary takes -addr
# and -state flags for development.

# Callers, declared inline as JSON: {"<name>": {"secret": "...", "scopes": [...]}}.
# The <name> is the identity that lands in the journal, so name it after the caller
# (an agent, a person, a CI job), not after the permission.
# Scopes: read, propose, approve, apply, admin. A secret is at least 32 characters.
TOKENS={"agent":{"secret":"sk_agent_change_me_change_me_change_me","scopes":["read","propose"]},"ops":{"secret":"sk_ops_change_me_change_me_change_me_xx","scopes":["read","propose","approve","apply","admin"]}}
# Same JSON from a mounted file instead of the environment, when escaping JSON in
# compose is worse than mounting a secret. Wins over TOKENS when set.
# TOKENS_FILE=/run/secrets/noxis-tokens.json

# 32 bytes, hex or base64. Seals target passwords in the state file; unset means a
# target that has a password cannot be created.
SECRET_KEY=
# Rotation: keys that no longer seal but may still open, comma-separated. Put the old key here, restart,
# re-save each password (`noxis instance set <ref> --password … --probe`), then remove it. Everything
# written after a rotation is sealed by SECRET_KEY.
# SECRET_KEY_OLD=

QUERY_TIMEOUT=30s
PROBE_TIMEOUT=5s

# The browser origins allowed to call the API. The console may be served from another host than the
# API, and only this deployment knows which one; the default is the Vite dev server on both names.
# CONSOLE_ORIGINS=https://console.example.com,http://localhost:5173

# Telemetry. No endpoint means no exporter at all: traces, metrics and logs stay in the
# process and the binary behaves as it did without a collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=noxis

# The version this deployment reports, and the commit it was built from. The publish job sets both; a local
# build wants `COMMIT=$(git rev-parse --short=7 HEAD)` so `noxis version` and the console name the tree.
# VERSION=dev
# COMMIT=

# Client side (noxis CLI).

# The console's own two variables. A deployment that runs `noxis web serve` without a CLI session names
# the API the browser should reach and the token the browser should use. The token is proved against
# /v1/whoami at boot: one the server refuses stops the console from listening instead of serving a
# sign-in page that reads as "up". Leave both empty and the console inherits the signed-in CLI profile.
# CONSOLE_HOST=https://api.example.com
# CONSOLE_TOKEN=
API_URL=http://localhost:9000
API_TOKEN=
