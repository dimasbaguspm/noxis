# noxis configuration. Copy to `.env` (git-ignored) and set the required values;
# docker compose reads `.env` from this directory automatically.
#
# Only NOXIS_SECRET_KEY is required. Everything else has a default or is opt-in.

# Required: 32 bytes as 64 hex characters. Generate with: openssl rand -hex 32
# Encrypts stored connection passwords. Losing it loses those passwords.
NOXIS_SECRET_KEY=

# Optional: where the API listens and where the SQLite registry lives.
# NOXIS_LISTEN=:9000
# NOXIS_DB=/data/noxis.db

# External scheduler trigger (shared with the external service that drives it).
# NOXIS_SCHEDULER_API_KEY=
# NOXIS_SCHEDULER_SECRET=

# OIDC login (optional). Empty keeps OIDC off.
# NOXIS_OIDC_ISSUER=
# NOXIS_OIDC_CLIENT_ID=
# NOXIS_OIDC_AUDIENCE=
# NOXIS_OIDC_GROUPS_CLAIM=groups

# OpenTelemetry export (optional). The collector is an OTLP/HTTP endpoint: the
# signal path (/v1/traces, /v1/logs, /v1/metrics) is added when the URL has none,
# https:// enables TLS and a bare host:port stays plaintext. With a collector
# set, traces, logs and metrics are exported and logs are NOT written to stdout;
# with none set, logs fall back to JSON on stdout so the process is never silent.
# NOXIS_OTEL_COLLECTOR=https://collector.example.com
# NOXIS_OTEL_NAME=noxis

# per-connection access grant lifetime in days (default 120; the super admin never expires)
# NOXIS_ACCESS_GRANT_DAYS=120
