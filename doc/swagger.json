{
    "swagger": "2.0",
    "info": {
        "description": "Master REST API: frontends read node state here; the master",
        "title": "noxis control plane API",
        "contact": {},
        "version": "0.1.0"
    },
    "paths": {
        "/healthz": {
            "get": {
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "process is alive"
                    }
                }
            }
        },
        "/openapi.json": {
            "get": {
                "summary": "This OpenAPI spec (json)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/openapi.yaml": {
            "get": {
                "summary": "This OpenAPI spec (yaml)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "summary": "Readiness probe (sqlite ping)",
                "responses": {
                    "200": {
                        "description": "store is reachable"
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/query": {
            "post": {
                "summary": "Run a query against an engine on the node (SQL engines)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "engine and SQL",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/modules.queryRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/modules.queryOutput"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "node not connected",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/register": {
            "post": {
                "summary": "Register a slave node (one-shot)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "registered"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/spec": {
            "get": {
                "summary": "Read a node's desired engines",
                "parameters": [
                    {
                        "type": "string",
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/entity.Spec"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Set a node's desired engines (publishes the event to the slave)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "desired engines",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/modules.putSpecBody"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "accepted and published"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/status": {
            "get": {
                "summary": "Node statuses (reported runtime merged with registered nodes)",
                "responses": {
                    "200": {
                        "description": "status of every node",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "nodes": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/entity.NodeStatus"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "entity.Engine": {
            "type": "object",
            "properties": {
                "env": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "ports": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "type": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "entity.NodeStatus": {
            "type": "object",
            "properties": {
                "detail": {
                    "type": "string"
                },
                "node": {
                    "type": "string"
                },
                "state": {
                    "description": "ok | error",
                    "type": "string"
                },
                "ts": {
                    "description": "unix seconds",
                    "type": "integer",
                    "format": "int64"
                }
            }
        },
        "entity.Spec": {
            "type": "object",
            "properties": {
                "engines": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/entity.Engine"
                    }
                },
                "node": {
                    "type": "string"
                }
            }
        },
        "modules.putSpecBody": {
            "type": "object",
            "properties": {
                "engines": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/entity.Engine"
                    }
                }
            }
        },
        "modules.queryOutput": {
            "type": "object",
            "properties": {
                "output": {
                    "type": "string"
                }
            }
        },
        "modules.queryRequest": {
            "type": "object",
            "properties": {
                "engine": {
                    "type": "string"
                },
                "sql": {
                    "type": "string"
                }
            }
        }
    }
}