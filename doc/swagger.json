{
    "openapi": "3.0.0",
    "info": {
        "description": "Master REST API: frontends read node state here; the master",
        "title": "noxis control plane API",
        "contact": {},
        "version": "0.1.0"
    },
    "paths": {
        "/healthz": {
            "get": {
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "process is alive"
                    }
                }
            }
        },
        "/v1/nodes/{node}/doorman/alter": {
            "post": {
                "summary": "Apply an ALTER TABLE on the node's engine",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/control.OpRequest"
                },
                "responses": {
                    "200": {
                        "description": "result output",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "output": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/doorman/analytics": {
            "post": {
                "summary": "Analyze a table (ANALYZE / ANALYZE TABLE)",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/control.OpRequest"
                            }
                        }
                    },
                    "description": "engine and table",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "result output",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "output": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/doorman/query": {
            "post": {
                "summary": "Run a doorman DB op (query | alter | rollback | analytics)",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/control.OpRequest"
                            }
                        }
                    },
                    "description": "op, engine, and sql/table",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "result output",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "output": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/doorman/rollback": {
            "post": {
                "summary": "Dry-run a change inside a transaction that always rolls back",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "$ref": "#/components/requestBodies/control.OpRequest"
                },
                "responses": {
                    "200": {
                        "description": "result output",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "output": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/register": {
            "post": {
                "summary": "Register a slave node (one-shot)",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "registered"
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/nodes/{node}/spec": {
            "get": {
                "summary": "Read a node's desired engines",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/entity.Spec"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Set a node's desired engines (publishes the event to the slave)",
                "parameters": [
                    {
                        "description": "slave node id",
                        "name": "node",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/controller.putSpecBody"
                            }
                        }
                    },
                    "description": "desired engines",
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "accepted and published"
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/status": {
            "get": {
                "summary": "Node statuses (registry merged with live heartbeats)",
                "responses": {
                    "200": {
                        "description": "status of every node",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "nodes": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/entity.NodeStatus"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "requestBodies": {
            "control.OpRequest": {
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/control.OpRequest"
                        }
                    }
                },
                "description": "engine and SQL",
                "required": true
            }
        },
        "schemas": {
            "control.OpRequest": {
                "type": "object",
                "properties": {
                    "engine": {
                        "type": "string"
                    },
                    "op": {
                        "description": "query | alter | rollback | analytics",
                        "type": "string"
                    },
                    "sql": {
                        "type": "string"
                    },
                    "table": {
                        "type": "string"
                    }
                }
            },
            "controller.putSpecBody": {
                "type": "object",
                "properties": {
                    "engines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/entity.Engine"
                        }
                    }
                }
            },
            "entity.Engine": {
                "type": "object",
                "properties": {
                    "env": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "name": {
                        "type": "string"
                    },
                    "ports": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "type": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    }
                }
            },
            "entity.NodeStatus": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    },
                    "node": {
                        "type": "string"
                    },
                    "state": {
                        "description": "ok | error | up | offline",
                        "type": "string"
                    },
                    "ts": {
                        "description": "unix seconds",
                        "type": "integer",
                        "format": "int64"
                    }
                }
            },
            "entity.Spec": {
                "type": "object",
                "properties": {
                    "engines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/entity.Engine"
                        }
                    },
                    "node": {
                        "type": "string"
                    }
                }
            }
        }
    }
}